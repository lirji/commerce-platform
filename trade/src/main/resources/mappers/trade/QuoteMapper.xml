<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lrj.commerce.trade.infrastructure.QuoteMapper">
 <insert id="insert">INSERT INTO trade_quote(tenant_id,quote_id,member_id,store_id,merchant_id,gross_amount,discount_amount,payable_amount,snapshot_json,expires_at,created_at) VALUES(#{tenant},#{view.quoteId},#{view.memberId},#{view.storeId},#{view.merchantId},#{view.gross},#{view.discount},#{view.payable},#{json},#{view.expiresAt},#{view.createdAt})</insert>
 <select id="read" resultType="string">SELECT snapshot_json FROM trade_quote WHERE tenant_id=#{tenant} AND member_id=#{member} AND quote_id=#{id}</select>
</mapper>
