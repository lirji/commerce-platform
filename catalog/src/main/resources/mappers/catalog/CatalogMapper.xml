<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lrj.commerce.catalog.infrastructure.CatalogMapper">
 <sql id="columns">sku_id,store_id,title,CAST(unit_price AS CHAR) AS unit_price,revision,status</sql>
 <insert id="insert">INSERT INTO catalog_sku(tenant_id,sku_id,store_id,title,unit_price,revision,status) VALUES(#{tenant},#{input.skuId},#{input.storeId},#{input.title},#{input.unitPrice},1,'ACTIVE')</insert>
 <select id="list" resultType="com.lrj.commerce.catalog.api.CatalogApi$View">SELECT <include refid="columns"/> FROM catalog_sku WHERE tenant_id=#{tenant} AND store_id=#{store} AND status='ACTIVE' AND sku_id &gt; #{after} ORDER BY sku_id LIMIT #{limit}</select>
 <select id="batch" resultType="com.lrj.commerce.catalog.api.CatalogApi$View">SELECT <include refid="columns"/> FROM catalog_sku WHERE tenant_id=#{tenant} AND store_id=#{store} AND status='ACTIVE' AND sku_id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach> ORDER BY sku_id</select>
</mapper>
