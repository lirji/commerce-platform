+    display: grid;
+    grid-template-columns: minmax(0, 2fr) repeat(2, minmax(0, 1fr));
+  }
+
+  .filters :global(.ant-form-item) {
+    max-width: none;
+  }
+
+  .filters > button {
+    justify-self: start;
+  }
+}
+
+@container (width < 520px) {
+  .skuTable {
+    /* 734px 是售价之后六列的总宽度，首屏空间留给勾选、名称、状态和售价。 */
+    --sku-table-width: calc(100cqw - 10px + 734px);
+    --sku-selection-width: 36px;
+    --sku-status-width: 68px;
+    --sku-price-width: 96px;
+  }
+
+  .filters,
+  .listHeader {
+    padding: 12px;
+  }
+
+  .listError {
+    padding-inline: 12px;
+  }
+
+  .filters {
+    grid-template-columns: minmax(0, 1fr) auto auto;
+    gap: 8px;
+  }
+
+  .filters .keyword {
+    grid-column: 1 / -1;
+  }
+
+  .filters > .moreFilters {
+    display: inline-flex;
+    padding-inline: 6px;
+    color: var(--muted);
+  }
+
+  .extraFilters {
+    display: none;
+  }
+
+  .extraFiltersOpen {
+    display: grid;
+    grid-column: 1 / -1;
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+    gap: 8px;
+    padding-block-start: 8px;
+    border-top: 1px solid var(--line);
+  }
+
+  .extraFiltersOpen .categoryFilter {
+    grid-column: 1 / -1;
+  }
+
+  .extraFiltersOpen + .submitFilters {
+    grid-column: 1 / -1;
+  }
+
+  .listHeader,
+  .listActions {
+    gap: 8px;
+  }
+
+  .skuTable :global(.ant-table-thead) > tr > th,
+  .skuTable :global(.ant-table-tbody) > tr > td {
+    padding-inline: 8px;
+  }
+
+  .skuTable :global(.catalog-identity) {
+    gap: 8px;
+  }
+
+  .skuTable .thumbnail {
+    width: 32px;
+    height: 32px;
+  }
+}
