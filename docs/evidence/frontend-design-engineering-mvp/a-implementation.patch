index 0000000..38649cc
--- /dev/null
+++ b/frontend/src/features/product-operations.module.css
@@ -0,0 +1,211 @@
+.skuList {
+  min-width: 0;
+}
+
+.skuList :global(.list-toolbar) {
+  display: block;
+  padding: 0;
+  border-bottom: 0;
+}
+
+.filterRegion {
+  container-type: inline-size;
+  padding: 16px 20px;
+}
+
+.filters {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  align-items: end;
+  gap: 12px;
+}
+
+.filters :global(.ant-form-item) {
+  min-width: 0;
+  margin-bottom: 0;
+}
+
+.filters :global(.ant-form-item-label) {
+  padding-bottom: 4px;
+}
+
+.filters :global(.ant-input-number) {
+  width: 100%;
+}
+
+.filterActions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+
+@container (min-width: 850px) {
+  .filters {
+    grid-template-columns:
+      minmax(170px, 1.6fr) minmax(100px, 0.8fr) minmax(120px, 1fr)
+      repeat(2, minmax(96px, 0.65fr)) auto;
+  }
+}
+
+@container (max-width: 540px) {
+  .filters {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .keyword,
+  .filterActions {
+    grid-column: 1 / -1;
+  }
+}
+
+.listActions {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 12px;
+  padding: 10px 20px;
+  border-top: 1px solid var(--line);
+  border-bottom: 1px solid var(--line);
+}
+
+.createAction > :global(.ant-btn-primary:not(:disabled)) {
+  color: var(--button-text);
+  background: var(--surface);
+  border-color: var(--button-border);
+}
+
+.createAction > :global(.ant-btn-primary:not(:disabled):hover) {
+  background: var(--button-hoverBg);
+  border-color: var(--button-hoverBorder);
+}
+
+.createAction > :global(.ant-btn-primary:not(:disabled):active) {
+  color: var(--button-primary);
+  background: var(--button-selectedBg);
+  border-color: var(--button-primary);
+}
+
+.toolbar > :global(.error-notice) {
+  margin: 12px 20px 16px;
+}
+
+.skuList :global(.list-panel .ant-table-thead > tr > th),
+.skuList :global(.list-panel .ant-table-tbody > tr > td) {
+  padding: 10px 12px;
+}
+
+.skuList
+  :global(.list-panel .ant-table-tbody > tr.ant-table-row-selected > td) {
+  background: var(--selected);
+}
+
+.skuList :global(.table-overflow-hint) {
+  margin: 8px 20px;
+}
+
+.thumbnail {
+  position: relative;
+}
+
+.thumbnail > img {
+  position: absolute;
+  inset: 0;
+  background: var(--raised);
+}
+
+.skuTitle,
+.identifier,
+.specifications {
+  overflow-wrap: anywhere;
+}
+
+.skuTitle,
+.price {
+  font-weight: 600;
+}
+
+.identifier,
+.specifications {
+  color: var(--muted);
+}
+
+.price {
+  font-variant-numeric: tabular-nums;
+  overflow-wrap: anywhere;
+}
+
+.skuList :global(.status-tag).onSale {
+  margin-inline-end: 0;
+  color: var(--ok);
+  background: var(--okSoft);
+  border-color: transparent;
+}
+
+.skuList :global(.status-tag).offSale {
+  margin-inline-end: 0;
+  color: var(--idle);
+  background: var(--idleSoft);
+  border-color: transparent;
+}
+
+.skuList :global(.row-actions) {
+  display: inline-grid;
+  grid-template-columns: max-content max-content;
+  justify-items: start;
+  gap: 0 16px;
+  text-align: start;
+}
+
+.skuList :global(.row-actions > .ant-btn) {
+  padding-inline: 2px;
+}
+
+@media (max-width: 767px) {
+  .filterRegion,
+  .listActions {
+    padding-inline: 12px;
+  }
+
+  .toolbar > :global(.error-notice) {
+    margin-inline: 12px;
+  }
+}
+
+@media (max-width: 575px) {
+  :global(.workbench):has(> .skuTabs) > :global(.page-head) {
+    margin-bottom: 6px;
+    padding-bottom: 12px;
+  }
+
+  :global(.admin-app .workspace) .skuTabs > :global(.ant-tabs-nav) {
+    margin-bottom: 12px;
+  }
+
+  .filterRegion {
+    padding-block: 12px;
+  }
+
+  .filters,
+  .listActions {
+    row-gap: 8px;
+  }
+
+  .listActions :global(.ant-space-item):has(> .batchHint) {
+    display: none;
+  }
+
+  .skuList :global(.list-panel .ant-table-thead > tr > th),
+  .skuList :global(.list-panel .ant-table-tbody > tr > td) {
+    padding-inline: 8px;
+  }
+
+  .skuList :global(.catalog-identity) {
+    gap: 8px;
+  }
+
+  .skuList .thumbnail {
+    width: 32px;
+    height: 32px;
+  }
+}
