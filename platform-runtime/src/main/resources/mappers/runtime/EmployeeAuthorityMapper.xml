<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lrj.commerce.runtime.access.persistence.EmployeeAuthorityMapper">
 <insert id="audit">INSERT INTO employee_command_identity(tenant_id,actor_id,operation,command_key,principal_id,membership_id,generation,execution_id,capability,store_id,route_version,resource_type,resource_id) VALUES(#{permit.tenant},#{actor.actorId},#{operation},#{key},#{permit.identity.principalId},#{permit.identity.membershipId},#{permit.identity.generation},#{actor.executionId},#{capability},#{permit.fact.id},#{permit.route.version},'store',#{permit.fact.id})</insert>
 <insert id="auditScoped">INSERT INTO employee_command_identity(tenant_id,actor_id,operation,command_key,principal_id,membership_id,generation,execution_id,capability,store_id,route_version,resource_type,resource_id) VALUES(#{permit.tenant},#{actor.actorId},#{operation},#{key},#{permit.identity.principalId},#{permit.identity.membershipId},#{permit.identity.generation},#{actor.executionId},#{capability},#{storeId},#{permit.route.version},#{resourceType},#{resourceId})</insert>
 <insert id="auditVersioned">INSERT INTO employee_command_identity(tenant_id,actor_id,operation,command_key,principal_id,membership_id,generation,execution_id,capability,store_id,route_version,resource_type,resource_id,resource_version) VALUES(#{permit.tenant},#{actor.actorId},#{operation},#{key},#{permit.identity.principalId},#{permit.identity.membershipId},#{permit.identity.generation},#{actor.executionId},#{capability},NULL,#{permit.route.version},#{permit.capability.resourceType},#{resourceId},#{resourceVersion})</insert>
 <insert id="rememberSegmentExecution">INSERT INTO employee_segment_execution(tenant_id,actor_id,execution_id,source_json) VALUES(#{actor.tenantId},#{actor.actorId},#{actor.executionId},#{json})</insert>
 <select id="segmentExecution" resultType="string">SELECT CAST(source_json AS CHAR) FROM employee_segment_execution WHERE tenant_id=#{actor.tenantId} AND actor_id=#{actor.actorId} AND execution_id=#{actor.executionId}</select>
 <sql id="columns">tenant_id,auth_tenant_id,family,state,ever_central,version</sql>
 <select id="find" resultType="com.lrj.commerce.runtime.api.access.EmployeeAccess$Route">SELECT <include refid="columns"/> FROM employee_authority_route WHERE tenant_id=#{tenant} AND family=#{family}</select>
 <select id="lock" resultType="com.lrj.commerce.runtime.api.access.EmployeeAccess$Route">SELECT <include refid="columns"/> FROM employee_authority_route WHERE tenant_id=#{tenant} AND family=#{family} FOR SHARE</select>
 <select id="central" resultType="com.lrj.commerce.runtime.api.access.EmployeeAccess$Route">SELECT <include refid="columns"/> FROM employee_authority_route WHERE auth_tenant_id=#{authTenant} AND family=#{family} AND state='CENTRAL'</select>
</mapper>
