<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lrj.commerce.runtime.access.persistence.EmployeeAuthorityMapper">
 <insert id="audit">INSERT INTO employee_command_identity(tenant_id,actor_id,operation,command_key,principal_id,membership_id,generation,execution_id,capability,store_id,route_version) VALUES(#{permit.tenant},#{actor.actorId},#{operation},#{key},#{permit.identity.principalId},#{permit.identity.membershipId},#{permit.identity.generation},#{actor.executionId},#{capability},#{permit.fact.id},#{permit.route.version})</insert>
 <sql id="columns">tenant_id,auth_tenant_id,family,state,ever_central,version</sql>
 <select id="find" resultType="com.lrj.commerce.runtime.api.access.EmployeeAccess$Route">SELECT <include refid="columns"/> FROM employee_authority_route WHERE tenant_id=#{tenant} AND family=#{family}</select>
 <select id="lock" resultType="com.lrj.commerce.runtime.api.access.EmployeeAccess$Route">SELECT <include refid="columns"/> FROM employee_authority_route WHERE tenant_id=#{tenant} AND family=#{family} FOR SHARE</select>
 <select id="central" resultType="com.lrj.commerce.runtime.api.access.EmployeeAccess$Route">SELECT <include refid="columns"/> FROM employee_authority_route WHERE auth_tenant_id=#{authTenant} AND family=#{family} AND state='CENTRAL'</select>
</mapper>
